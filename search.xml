        <content type="html"><![CDATA[<style>  /* ===== 全局样式 ===== */  .crosshair-container {    max-width: 100%;    margin: 0 auto;    padding: 20px 30px;  }  .crosshair-container h1 {    text-align: center;    font-size: 2.2rem;    margin-bottom: 0.5rem;    color: var(--anzhiyu-fontcolor, #1a1a2e);  }  .crosshair-subtitle {    text-align: center;    color: var(--anzhiyu-secondtext, #666);    margin-bottom: 2rem;  }  /* ===== 标签切换栏 ===== */  .tabs {    display: flex;    justify-content: center;    gap: 16px;    margin-bottom: 30px;    flex-wrap: wrap;  }  .tab-btn {    padding: 10px 32px;    border: 2px solid #eaeef2;    border-radius: 40px;    background: transparent;    font-size: 1rem;    font-weight: 600;    color: #666;    cursor: pointer;    transition: all 0.3s ease;  }  .tab-btn:hover {    border-color: #4f46e5;    color: #4f46e5;  }  .tab-btn.active {    background: #4f46e5;    border-color: #4f46e5;    color: #fff;  }  .tab-btn.active:hover {    background: #4338ca;    border-color: #4338ca;  }  /* ===== 准星网格 ===== */  .crosshair-grid {    display: grid;    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));    gap: 30px;  }  .crosshair-card {    background: var(--anzhiyu-card-bg, #ffffff);    border-radius: 16px;    padding: 0 0 25px 0;    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);    text-align: center;    transition: transform 0.2s, box-shadow 0.2s;    border: 1px solid var(--anzhiyu-border-color, #eaeef2);    display: flex;    flex-direction: column;    align-items: center;    overflow: hidden;  }  .crosshair-card:hover {    transform: translateY(-6px);    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);  }  .crosshair-preview-img {    width: 100%;    height: 200px;    /* --- 关键修改开始 --- */    /* 移除 object-fit，改用 background 方式显示图片，兼容性更好 */    background-size: contain;    background-repeat: no-repeat;    background-position: center;    background-color: #1a1a2e;    /* --- 关键修改结束 --- */    border-radius: 16px 16px 0 0;    padding: 8px;    box-sizi