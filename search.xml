        <content type="html"><![CDATA[<style>  /* ===== 全局样式 ===== */  .crosshair-container {    max-width: 100%;    margin: 0 auto;    padding: 20px 30px;  }  .crosshair-container h1 {    text-align: center;    font-size: 2.2rem;    margin-bottom: 0.5rem;    color: var(--anzhiyu-fontcolor, #1a1a2e);  }  .crosshair-subtitle {    text-align: center;    color: var(--anzhiyu-secondtext, #666);    margin-bottom: 2rem;  }  /* ===== 标签切换栏 ===== */  .tabs {    display: flex;    justify-content: center;    gap: 16px;    margin-bottom: 30px;    flex-wrap: wrap;  }  .tab-btn {    padding: 10px 32px;    border: 2px solid #eaeef2;    border-radius: 40px;    background: transparent;    font-size: 1rem;    font-weight: 600;    color: #666;    cursor: pointer;    transition: all 0.3s ease;  }  .tab-btn:hover {    border-color: #4f46e5;    color: #4f46e5;  }  .tab-btn.active {    background: #4f46e5;    border-color: #4f46e5;    color: #fff;  }  .tab-btn.active:hover {    background: #4338ca;    border-color: #4338ca;  }  /* ===== 准星网格 ===== */  .crosshair-grid {    display: grid;    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));    gap: 30px;  }  .crosshair-card {    background: var(--anzhiyu-card-bg, #ffffff);    border-radius: 16px;    padding: 0 0 25px 0;    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);    text-align: center;    transition: transform 0.2s, box-shadow 0.2s;    border: 1px solid var(--anzhiyu-border-color, #eaeef2);    display: flex;    flex-direction: column;    align-items: center;    overflow: hidden;  }  .crosshair-card:hover {    transform: translateY(-6px);    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);  }  .crosshair-preview-img {    width: 100%;    height: 200px;    object-fit: contain;    background: #1a1a2e;    border-radius: 16px 16px 0 0;    padding: 8px;    box-sizing: border-box;    margin-bottom: 12px;  }  .player-name {    font-weight: 600;    font-size: 1.2rem;    margin: 0 0 14px 0;    color: var(--anzhiyu-fontcolor, #1a1a2e);    padding: 0 12px;  }  .copy-btn {    background: #4f46e5;    color: #fff;    border: none;    padding: 10px 20px;    border-radius: 24px;    font-size: 0.9rem;    cursor: pointer;    transition: background 0.2s;    width: calc(100% - 32px);    font-weight: 500;    margin: 0 16px 4px 16px;  }  .copy-btn:hover {    background: #4338ca;  }  .copy-btn.copied {    background: #10b981;  }  /* ===== 空状态 ===== */  .empty-tip {    grid-column: 1/-1;    text-align: center;    color: #888;    padding: 40px 0;  }  @media (max-width: 480px) {    .crosshair-grid {      grid-template-columns: repeat(2, 1fr);      gap: 16px;    }    .crosshair-preview-img {      height: 120px;    }    .player-name {      font-size: 1rem;    }    .tab-btn {      padding: 8px 20px;      font-size: 0.9rem;    }  }</style><div class="crosshair-container">  <h1>🎯 无畏契约准星库</h1>  <p class="crosshair-subtitle">点击下方按钮复制专业玩家的准星代码</p>  <!-- ===== 标签切换 ===== -->  <div class="tabs">    <button class="tab-btn active" data-tab="pro">🏆 专业玩家</button>    <button class="tab-btn" data-tab="creative">🎨 创意库</button>  </div>  <!-- ===== 准星网格容器 ===== -->  <div class="crosshair-grid" id="crosshairGrid"></div></div><script>  // ============================================================  // 数据定义  // ============================================================  // ---- 专业玩家数据 ----  var proPlayers = [    { player: "TenZ", preview: "/images/crosshairs/tenz.png", code: "0;s;1;P;c;5;h;0;m;1;0l;4;0o;2;0a;1;0f;0;1b;0;S;c;4;o;1" },    { player: "yay", preview: "/images/crosshairs/yay.png", code: "0;P;h;0;f;0;0l;4;0o;0;0a;1;0f;0;1b;0" },    { player: "Sacy", preview: "/images/crosshairs/sacy.png", code: "0;P;h;0;f;0;0t;1;0l;4;0o;1;0a;1;0f;0;1t;3;1o;2;1a;1;1m;0;1f;0" },    { player: "f0rsakeN", preview: "/images/crosshairs/f0rsaken.png", code: "0;P;o;1;f;0;0t;1;0l;1;0o;4;0a;1;0f;0;1t;1;1l;1;1o;3;1a;0;1m;0;1f;0" },    { player: "ScreaM", preview: "/images/crosshairs/scream.png", code: "0;P;c;5;o;0.286;d;1;f;0;0t;0;0l;0;0o;0;0a;1;0f;0;1b