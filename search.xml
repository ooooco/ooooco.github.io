elector 查找      btn.addEventListener('click', function() {        var code = this.dataset.code;        if (!code) return;        navigator.clipboard.writeText(code).then(function() {          this.textContent = '✅ 已复制!';          this.classList.add('copied');          var self = this;          setTimeout(function() {            self.textContent = '复制代码';            self.classList.remove('copied');          }, 2000);        }.bind(this)).catch(function() {          alert('请手动复制代码：\n' + code);        });      });      card.appendChild(preview);      card.appendChild(name);      card.appendChild(btn);      fragment.appendChild(card);    }    grid.appendChild(fragment);  }  // ============================================================  // 切换标签  // ============================================================  function switchTab(tab) {    // 更新按钮样式    var buttons = document.querySelectorAll('.tab-btn');    for (var i = 0; i < buttons.length; i++) {      buttons[i].classList.toggle('active', buttons[i].getAttribute('data-tab') === tab);    }    // 选择数据并渲染    var data = (tab === 'pro') ? proPlayers : creativePlayers;    renderGrid(data);  }  // ============================================================  // 绑定标签点击事件  // ============================================================  var tabButtons = document.querySelectorAll('.tab-btn');  for (var k = 0; k < tabButtons.length; k++) {    tabButtons[k].addEventListener('click', function() {      var tab = this.getAttribute('data-tab');      switchTab(tab);    });  }  // ============================================================  // 初始化：默认显示"专业玩家"  // ============================================================  // 确保 DOM 完全加载后再初始化  if (document.readyState === 'loading') {    document.addEventListener('DOMContentLoaded', function() {      switchTab('pro');    });  } else {    switchTab('pro');  }</script>]]></content>
      
      
      
