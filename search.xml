有内容，包括之前绑定的事件）    grid.innerHTML = '';    if (!data || data.length === 0) {      grid.innerHTML = '<p class="empty-tip">暂无数据，请添加。</p>';      return;    }    // 使用 document.createDocumentFragment 批量添加，性能更好    var fragment = document.createDocumentFragment();    for (var i = 0; i < data.length; i++) {      var item = data[i];      var card = document.createElement('div');      card.className = 'crosshair-card';      var preview = document.createElement('div');  // 把 img 改成 div      preview.className = 'crosshair-preview-img';      preview.style.backgroundImage = 'url(' + item.preview + ')';  // 用背景图显示      preview.alt = item.player + ' 准星';      preview.loading = 'lazy';      var name = document.createElement('p');      name.className = 'player-name';      name.textContent = item.player;      var btn = document.createElement('button');      btn.className = 'copy-btn';      btn.textContent = '复制代码';      btn.dataset.code = item.code;      // 直接在这里绑定事件，而不是之后用 querySelector 查找      btn.addEventListener('click', function() {        var code = this.dataset.code;        if (!code) return;        navigator.clipboard.writeText(code).then(function() {          this.textContent = '✅ 已复制!';          this.classList.add('copied');          var self = this;          setTimeout(function() {            self.textContent = '复制代码';            self.classList.remove('copied');          }, 2000);        }.bind(this)).catch(function() {          alert('请手动复制代码：\n' + code);        });      });      card.appendChild(preview);      card.appendChild(name);      card.appendChild(btn);      fragment.appendChild(card);    }    grid.appendChild(fragment);  }  // ============================================================  // 切换标签  // ============================================================  function switchTab(tab) {    var buttons = document.querySelectorAll('.tab-btn');    for (var i = 0; i < buttons.length; i++) {      buttons[i].classList.toggle('active', buttons[i].getAttribute('data-tab') === tab);    }    var data = (tab === 'pro') ? proPlayers : creativePlayers;    renderGrid(data);    // 清空搜索框    var searchInput = document.getElementById('searchInput');    if (searchInput) searchInput.value = '';  }  // ============================================================  // 搜索功能  // ============================================================  var searchInput = document.getElementById('searchInput');  function filterCards(keyword) {    var cards = document.querySelectorAll('.crosshair-card');    var hasVisible = false;    var keywordLower = keyword.toLowerCase().trim();    cards.forEach(function(card) {      var nameEl = card.querySelector('.player-name');      if (!nameEl) return;      var name = nameEl.textContent.toLowerCase();      if (keyword === '' || name.includes(keywordLower)) {        card.style.display = '';        hasVisible = true;      } else {        card.style.display = 'none';      }    });    var grid = document.getElementById('crosshairGrid');    var existingTip = grid.querySelector('.search-empty-tip');    if (!hasVisible && keyword.trim() !== '') {      if (!existingTip) {        var tip = document.createElement('p');        tip.className = 'search-empty-tip';        tip.style.cssText = 'grid-column:1/-1; text-align:center; color:#888; padding:40px 0;';        tip.textContent = '🔍 未找到 "' + keyword.trim() + '" 相关的玩家';        grid.appendChild(tip);      }    } else {      if (existingTip) existingTip.remove();    }  }  if (searchInput) {    searchInput.addEventListener('input', function() {      filterCards(this.value);    });  }  // ============================================================  // 绑定标签点击事件  // ============================================================  var tabButtons = document.querySelectorAll('.tab-btn');  for (var k = 0; k < tabButtons.length; k++) {    tabButtons[k].addEventListener('click', function() {      var tab = this.getAttribute('data-tab');      switchTab(tab);    });  }  // ============================================================  // 初始化  // ============================================================  if (document.readyState === 'loading') {    document.addEventListener('DOMContentLoaded', function() {      switchTab('pro');    });  } else {    switchTab('pro');  }  // ============================================================  // 修复 Pjax 导致的图片渲染问题  // ============================================================  function fixImageLayout() {    var images = document.querySelectorAll('.crosshair-preview-img');    images.forEach(function(img) {      img.style.display = 'none';      requestAnimationFrame(function() {        img.style.display = '';      });    });  }  document.addEventListener('pjax:complete', function() {    setTimeout(fixImageLayout, 150);  });  if (document.readyState === 'complete') {    setTimeout(fixImageLayout, 200);  } else {    window.addEventListener('load', function() {      setTimeout(fixImageLayout, 200);    });  }</script>]]></content>
      
      
      
