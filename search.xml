      <title>无畏契约选手库</title>
      <link href="/2026/07/28/players/"/>
      <url>/2026/07/28/players/</url>
      
        <content type="html"><![CDATA[<style>  .players-wrapper {    max-width: 100%;    margin: 0 auto;    padding: 20px 30px;  }  .players-wrapper h1 {    text-align: center;    font-size: 2.2rem;    margin-bottom: 0.5rem;    color: var(--anzhiyu-fontcolor, #1a1a2e);  }  .players-subtitle {    text-align: center;    color: var(--anzhiyu-secondtext, #666);    margin-bottom: 2rem;  }  .players-grid {    display: grid;    grid-template-columns: repeat(3, 1fr);    gap: 28px;    max-width: 100%;  }  .player-card {    background: var(--anzhiyu-card-bg, #ffffff);    border-radius: 20px;    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);    border: 1px solid var(--anzhiyu-border-color, #eaeef2);    overflow: hidden;    transition: transform 0.3s, box-shadow 0.3s;    display: flex;    flex-direction: column;    height: auto;    height: fit-content;  }  .player-card:hover {    transform: translateY(-6px);    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);  }  /* ===== 头像背景 ===== */  .player-cover {    position: relative;    width: 100%;    padding-top: 56.25%;    background: linear-gradient(135deg, #1a1a2e, #2d2d44);    overflow: hidden;    flex-shrink: 0;  }  .player-cover .avatar {    position: absolute;    top: 50%;    left: 50%;    transform: translate(-50%, -50%);    width: 100px;    height: 100px;    border-radius: 50%;    object-fit: cover;    border: 4px solid rgba(255, 255, 255, 0.3);    background: #1a1a2e;  }  .player-cover .country-flag {    position: absolute;    top: 14px;    right: 16px;    font-size: 1.8rem;    line-height: 1;    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));  }  .player-cover .player-name-overlay {    position: absolute;    bottom: 12px;    left: 16px;    color: #fff;    font-size: 1.3rem;    font-weight: 700;    text-shadow: 0 2px 12px rgba(0,0,0,0.6);    margin: 0;  }  /* ===== 卡片下半 ===== */  .player-body {    padding: 12px 14px 6px 14px;    flex: 1;     display: flex;    flex-direction: column;    gap: 2px;  }  .player-team-role {    font-size: 0.85rem;    color: var(--anzhiyu-secondtext, #666);  }  .player-bio {    font-size: 0.9rem;    color: var(--anzhiyu-secondtext, #666);    line-height: 1.4;    margin: 0;  }  /* ===== 荣誉 + 社交 ===== */  .player-meta-grid {    display: grid;    grid-template-columns: 3fr 2fr;    gap: 12px;    margin-top: 4px;    align-items: start;  }  .trophy-list {    display: flex;    flex-wrap: wrap;    gap: 4px;    justify-content: flex-start;  }  .trophy-tag {    background: var(--anzhiyu-main, #4f46e5);    color: #fff;    font-size: 0.65rem;    padding: 1px 12px;    border-radius: 12px;    font-weight: 600;    display: inline-block;    min-width: 80px;    text-align: center;  }  .social-grid {    display: grid;    grid-template-columns: 1fr 1fr;    gap: 2px 6px;    justify-items: end;  }  .social-grid a {    font-size: 0.75rem;    text-decoration: none;    color: var(--anzhiyu-fontcolor, #1a1a2e);    background: var(--anzhiyu-card-bg, #f0f2f5);    padding: 0 8px;    border-radius: 10px;    text-align: center;    line-height: 1.6;    opacity: 0.75;    white-space: nowrap;    min-width: 50px;  }  .social-grid a:hover {    opacity: 1;  }  /* ===== 赛场数据 - 固定宽度 ===== */  .stats-section {    padding-top: 6px;    border-top: 1px solid var(--anzhiyu-border-color, #eaeef2);  }  .stats-section-title {    font-size: 0.6rem;    font-weight: 600;    text-transform: uppercase;    letter-spacing: 0.5px;    color: var(--anzhiyu-secondtext, #888);    margin-bottom: 2px;  }  .stats-grid {    display: grid;    grid-template-columns: 1fr 1fr;    gap: 0px 12px;  }  .stat-item {    font-size: 0.78rem;    color: var(--anzhiyu-fontcolor, #1a1a2e);    padding: 1px 0;    display: flex;    gap: 4px;    min-width: 0;  }  .stat-item .label {    color: var(--anzhiyu-secondtext, #888);    flex-shrink: 0;  }  .stat-item .value {    font-weight: 700;    overflow: hidden;    text-overflow: ellipsis;    white-space: nowrap;  }  /* ===== 准星区域 ===== */  .crosshair-section {    padding-top: 6px;    border-top: 1px solid var(--anzhiyu-border-color, #eaeef2);    display: flex;    align-items: center;    gap: 12px;    min-height: 80px;  }  .crosshair-section .preview-wrap {    flex: 1;    min-width: 0;  }  .crosshair-section .preview-img {    width: 100%;    height: 100px;    border-radius: 8px;    background: #0f172a;    object-fit: contain;    padding: 1px;    border: 1px solid var(--anzhiyu-border-color, #eaeef2);    display: block;  }  .crosshair-section .right-area {    flex: 1;    min-width: 70px;    display: flex;    flex-direction: column;    align-items: center;    justify-content: center;    gap: 0px;  }  .crosshair-section .right-area .crosshair-label {    font-size: 1rem;    color: var(--anzhiyu-fontcolor, #1a1a2e);    font-weight: 500;    line-height: 1.4;  }  .crosshair-section .right-area .copy-btn-lg {    background: #4f46e5;    color: #fff;    border: none;    padding: 3px 14px;    border-radius: 14px;    font-size: 0.75rem;    cursor: pointer;    font-weight: 500;    transition: all 0.2s;    line-height: 1.6;  }  .crosshair-section .right-area .copy-btn-lg:hover {    background: #4338ca;    transform: scale(1.02);  }  .crosshair-section .right-area .copy-btn-lg.copied {    background: #10b981;  }  .empty-tip, .loading-tip {    grid-column: 1/-1;    text-align: center;    color: #888;    padding: 60px 0;  }  @media (max-width: 1024px) {    .players-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }  }  @media (max-width: 640px) {    .players-grid { grid-template-columns: 1fr; gap: 20px; }    .player-cover .avatar { width: 80px; height: 80px; }    .player-cover .player-name-overlay { font-size: 1.1rem; }    .crosshair-section .preview-img { height: 60px; }    .player-meta-grid { grid-template-columns: 1fr; gap: 6px; }    .social-grid { grid-template-columns: repeat(4, 1fr); justify-items: start; }    .stats-grid { grid-template-columns: 1fr 1fr; }  }</style><div class="players-wrapper">  <h1>👤 无畏契约选手库</h1>  <p class="players-subtitle">职业选手信息 · 准星配置 · 赛场数据</p>  <!-- 搜索框 --><div style="display: flex; justify-content: center; margin-bottom: 24px;">  <input type="text" id="searchInput" placeholder="🔍 搜索选手名或战队..." style="    width: 100%;    max-width: 400px;    padding: 10px 20px;    border: 2px solid var(--anzhiyu-border-color, #eaeef2);    border-radius: 40px;    font-size: 1rem;    background: var(--anzhiyu-card-bg, #ffffff);    color: var(--anzhiyu-fontcolor, #1a1a2e);    outline: none;    transition: border-color 0.3s;  " onfocus="this.style.borderColor='#4f46e5'" onblur="this.style.borderColor='var(--anzhiyu-border-color, #eaeef2)'"></div>  <div class="players-grid" id="playersGrid">    <p class="loading-tip">⏳ 加载数据中...</p>  </div></div><script>(() => {let playersData = [];let initialized = false;let searchBind = false;let loading = false;let retryCount = 0;const MAX_RETRY = 3;const grid = () => document.getElementById("playersGrid");const searchInput = () => document.getElementById("searchInput");function debounce(fn, delay){    let timer;    return function(){        const args = arguments;        clearTimeout(timer);        timer = setTimeout(()=>{            fn.apply(this,args);        },delay);    };}function safeCopy(text){    if(!text) return;    if(navigator.clipboard && window.isSecureContext){        navigator.clipboard.writeText(text).then(showCopySuccess).catch(()=>{            fallbackCopy(text);        });    }else{        fallbackCopy(text);    }}function fallbackCopy(text){    const textarea=document.createElement("textarea");    textarea.value=text;    textarea.style.position="fixed";    textarea.style.left="-9999px";    document.body.appendChild(textarea);    textarea.select();    try{        document.execCommand("copy");        showCopySuccess();    }catch(e){        alert("复制失败，请手动复制：\n"+text);    }    document.body.removeChild(textarea);}function showCopySuccess(){    document.querySelectorAll(".copy-btn-lg.copied").forEach(btn=>{        btn.classList.remove("copied");        btn.textContent="📋 复制代码";    });}function bindSearch(){    if(searchBind) return;    const input=searchInput();    if(!input) return;    searchBind=true;    input.addEventListener("input",debounce(function(){        const keyword=this.value.trim().toLowerCase();        let visible=0;        document.querySelectorAll(".player-card").forEach(card=>{            const name=(card.dataset.player||"").toLowerCase();            const team=(card.dataset.team||"").toLowerCase();            if(                keyword==="" ||                name.includes(keyword) ||                team.includes(keyword)            ){                card.style.display="flex";                visible++;            }else{                card.style.display="none";            }        });        let tip=document.querySelector(".search-empty-tip");        if(visible===0 && keyword){            if(!tip){                tip=document.createElement("p");                tip.className="search-empty-tip";                tip.style.cssText="grid-column:1/-1;text-align:center;padding:50px;color:#999;";                grid().appendChild(tip);            }            tip.textContent='🔍 未找到 "'+keyword+'"';        }else{            if(tip) tip.remove();        }    },250));}function renderPlayers(){    const container = grid();    if(!container) return;    if(!playersData || !playersData.length){        container.innerHTML='<p class="empty-tip">暂无选手数据</p>';        return;    }    let html=[];    playersData.forEach(function(p){        let trophies='';        if(Array.isArray(p.trophies) && p.trophies.length){            p.trophies.slice(0,2).forEach(function(t){                trophies+='<span class="trophy-tag">🏆 '+t+'</span>';            });        }else{            trophies='<span class="trophy-tag" style="background:#888;opacity:.35">暂无荣誉</span>';        }        let social='';        if(p.social){            Object.keys(p.social).forEach(function(key){                social+='<a href="'+p.social[key]+'" target="_blank">'+key+'</a>';            });        }        let stats='';        if(p.acs || p.kda || p.headshotRate || p.rating){            stats=`            <div class="stats-section">                <div class="stats-section-title">                📊 赛场数据                </div>                <div class="stats-grid">                    ${p.acs?`<div class="stat-item"><span class="label">ACS :</span><span class="value">${p.acs}</span></div>`:''}                    ${p.kda?`<div class="stat-item"><span class="label">KDA :</span><span class="value">${p.kda}</span></div>`:''}                    ${p.headshotRate?`<div class="stat-item"><span class="label">爆头率 :</span><span class="value">${p.headshotRate}%</span></div>`:''}                    ${p.rating?`<div class="stat-item"><span class="label">评分 :</span><span class="value">${p.rating}</span></div>`:''}                </div>            </div>            `;        }        let crosshair='';        if(p.code){            crosshair=`            <div class="crosshair-section">                <div class="preview-wrap">                    ${                        p.preview ?                        `<img                            class="preview-img"                            src="${p.preview}?v=${Date.now()}"                            alt="${p.player}"                            loading="eager"                            decoding="async"                            onerror="this.style.display='none';"                        >`                        :                        ''                    }                </div>                <div class="right-area">                    <span class="crosshair-label">                    🎯 准星                    </span>                    <button                        class="copy-btn-lg"                        data-code="${String(p.code).replace(/"/g,'&quot;')}">                        📋 复制代码                    </button>                </div>            </div>            `;        }        html.push(`        <div            class="player-card"            data-player="${p.player||''}"            data-team="${p.team||''}">            <div class="player-cover">                <img                    class="avatar"                    src="${(p.avatar||'/images/404.jpg')}?v=${Date.now()}"                    alt="${p.player}"                    loading="eager"                    decoding="async"                    fetchpriority="high"                    onerror="this.src='/images/404.jpg'">                <span class="country-flag">                ${p.country||''}                </span>                <div class="player-name-overlay">                ${p.player}                </div>            </div>            <div class="player-body">                <div class="player-team-role">                    ${p.team||'自由人'}                    ·                    ${p.role||'选手'}                </div>                <p class="player-bio">                    ${p.bio||'暂无简介'}                </p>                <div class="player-meta-grid">                    <div class="trophy-list">                        ${trophies}                    </div>                    <div class="social-grid">                        ${social}                    </div>                </div>                ${stats}                ${crosshair}            </div>        </div>        `);    });    container.innerHTML=html.join("");    requestAnimationFrame(function(){        document        .querySelectorAll(".copy-btn-lg")        .forEach(function(btn){            btn.onclick=function(e){                e.stopPropagation();                safeCopy(this.dataset.code);                this.classList.add("copied");                this.textContent="✅ 已复制";                const self=this;                setTimeout(function(){                    self.classList.remove("copied");                    self.textContent="📋 复制代码";                },2000);            };        });    });}function preloadImages(list){    const tasks=[];    list.forEach(function(p){        if(p.avatar){            tasks.push(new Promise(function(resolve){                const img=new Image();                img.onload=resolve;                img.onerror=resolve;                img.src=p.avatar;            }));        }        if(p.preview){            tasks.push(new Promise(function(resolve){                const img=new Image();                img.onload=resolve;                img.onerror=resolve;                img.src=p.preview;            }));        }    });    return Promise.all(tasks);}function loadPlayers(){    if(loading) return;    loading=true;    fetch("/players.json?_="+Date.now(),{        cache:"no-store"    })    .then(function(res){        if(!res.ok){            throw new Error(res.status);        }        return res.json();    })    .then(function(data){        retryCount=0;        playersData=data||[];        return preloadImages(playersData);    })    .then(function(){        requestAnimationFrame(function(){            renderPlayers();            bindSearch();            loading=false;        });    })    .catch(function(err){        console.error(err);        loading=false;        if(retryCount<MAX_RETRY){            retryCount++;            setTimeout(loadPlayers,600);            return;        }        if(grid()){            grid().innerHTML=            '<p class="empty-tip">❌ 数据加载失败，请检查 players.json</p>';        }    });}function initPlayers(){    if(initialized){        loadPlayers();        return;    }    initialized=true;    loadPlayers();}/* ---------- PJAX ---------- */document.addEventListener("DOMContentLoaded",function(){    initPlayers();});document.addEventListener("pjax:complete",function(){    initialized=false;    setTimeout(function(){        initPlayers();    },50);});/* Butterfly部分版本 */document.addEventListener("pjax:success",function(){    initialized=false;    setTimeout(function(){        initPlayers();    },50);});/* 返回上一页 */window.addEventListener("pageshow",function(e){    if(e.persisted){        initialized=false;        initPlayers();    }});/* 网络恢复 */window.addEventListener("online",function(){    if(playersData.length===0){        loadPlayers();    }});})();</script>]]></content>
      
      
      
    </entry>
    
    
    
    <entry>
      <title>无畏契约准星库</title>
